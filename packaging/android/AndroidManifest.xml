<?xml version="1.0" encoding="utf-8"?>
<!-- Pdfromeo for Android: the browser build (apps/pdfcraft-web) in a WebView. No network
     permission: the app's files are served from the APK under a virtual https origin. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.romizone.pdfromeo"
    android:versionCode="@VERSION_CODE@"
    android:versionName="@VERSION@">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <application
        android:label="Pdfromeo"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open with Pdfromeo from a file manager, browser download or share sheet. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
    </application>
</manifest>
